# Copy to .env and uncomment what you need. Everything is optional.

# PORT=5177
# STUDIO_DATA=./data

# Local transcription: a Python that has faster-whisper, and the models to use.
# STUDIO_PYTHON=C:/Python313/python.exe
# WHISPER_MODEL_HE=ivrit-ai/whisper-large-v3-turbo-ct2
# WHISPER_MODEL_EN=large-v3

# Cloud transcription key (or enter it in the studio under Captions > settings).
# OPENAI_API_KEY=
# GROQ_API_KEY=
# ELEVENLABS_API_KEY=

# Narration and voice cloning (or enter the key in the studio under Voice > settings).
# CARTESIA_API_KEY=

# Remote access through a tunnel (docs/REMOTE.md). Both are required together.
# STUDIO_ALLOWED_HOSTS=studio.example.com
# STUDIO_TOKEN=
# Cloudflare Access in front of it (see docs/REMOTE.md): one email sign-in instead of the token page
# STUDIO_ACCESS_TEAM=yourteam.cloudflareaccess.com
# STUDIO_ACCESS_AUD=
# STUDIO_ACCESS_EMAILS=you@example.com

# Free stock keys (or paste them in the Stock tab). Openverse needs none.
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# AI agent keys (or enter them in the AI agent tab)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
